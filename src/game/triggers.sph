<?php

// ============================================================================
// SantientPHP Game Engine: Level Trigger Scripting (Dynamic PHP Mode Showcase)
// Tests: Dynamic Scripting, Event Dispatching, In-Game Story Prompts
// ============================================================================

import "../engine/types.sph";

struct LevelTrigger {
    trigger_type: i32,
    col: i32,
    row: i32,
    is_triggered: bool,
    message: string,
}

fn trigger_create(t_type: i32, c: i32, r: i32, msg: string): LevelTrigger {
    return LevelTrigger {
        trigger_type: t_type,
        col: c,
        row: r,
        is_triggered: false,
        message: msg,
    };
}

// Executes dynamic level event script based on trigger type
fn trigger_execute(t: LevelTrigger, player_coins: i32): string {
    if (t.trigger_type == 1) {
        return "ANCIENT SHRINE: Seek the Golden Sun at the sky citadel!";
    } else if (t.trigger_type == 2) {
        return "WARNING: Cavern depth ahead! Beware of lurking Drones & Spikes!";
    } else if (t.trigger_type == 3) {
        return "BOSS ARENA: The Sky Knight guards the celestial realm!";
    }
    return t.message;
}
