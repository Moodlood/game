<?php

// ============================================================================
// SantientPHP Game Engine: 2D Platformer Gameplay Systems & Demonstration
// Features: Chiptune BGM/SFX, SIMD 2D Lighting, Platformer Juice, Reactive AI
// ============================================================================

import "../engine/types.sph";
import "../engine/canvas.sph";
import "../engine/texture.sph";
import "../engine/animation.sph";
import "../engine/collision.sph";
import "../engine/physics.sph";
import "../engine/input.sph";
import "../engine/audio.sph";
import "../engine/ecs.sph";
import "../engine/editor.sph";
import "levels.sph";
import "triggers.sph";

struct PlatformerGame {
    player: Entity,
    enemy_1: Entity,
    enemy_2: Entity,
    drone: Entity,
    turret: Entity,
    bullet: Entity,
    boss: Entity,
    platform: Entity,
    checkpoint: Entity,

    // Reactive Particles (16 slots)
    p0: Particle, p1: Particle, p2: Particle, p3: Particle,
    p4: Particle, p5: Particle, p6: Particle, p7: Particle,
    p8: Particle, p9: Particle, p10: Particle, p11: Particle,
    p12: Particle, p13: Particle, p14: Particle, p15: Particle,

    level_idx: i32,
    camera_x: f32,
    camera_y: f32,
    score: i32,
    coins: i32,
    is_level_cleared: bool,
    is_game_over: bool,
    cloud_scroll: f32,

    // Game Feel ("Juice") & Dynamic State
    jump_buffer_timer: f32,
    hitstop_timer: f32,
    shake_intensity: f32,
    shake_offset_x: f32,
    shake_offset_y: f32,
    checkpoint_x: f32,
    checkpoint_y: f32,
    spatial_grid: SpatialGrid,
    torch_timer: f32,
    boss_music_started: bool,
    level_title: string,
    biome: i32,
    has_lighting: bool,
}

fn platformer_game_create(level_idx: i32, map: LevelMap): PlatformerGame {
    let info: LevelInfo = build_level(map, level_idx);

    let spawn_x: f32 = 48.0 as f32;
    let spawn_y: f32 = 380.0 as f32;
    let ply = entity_create_player(1, spawn_x, spawn_y);

    audio_set_bgm(info.bgm_track);

    mut en1 = entity_create_empty(2);
    mut en2 = entity_create_empty(3);
    mut drn = entity_create_empty(4);
    mut tur = entity_create_empty(5);
    mut bss = entity_create_empty(6);
    mut plt = entity_create_empty(7);
    mut chk = entity_create_empty(8);
    mut chk_x: f32 = spawn_x;
    mut chk_y: f32 = spawn_y;

    // Scan map to instantiate entities from tile markers
    mut r: i32 = 0;
    while (r < map.rows) {
        mut c: i32 = 0;
        while (c < map.cols) {
            let t: i32 = level_map_get_tile(map, c, r);
            let wx: f32 = (c * 16) as f32;
            let wy: f32 = (r * 16) as f32;

            if (t == 9) { // Checkpoint Flag
                chk = entity_create_checkpoint(8, wx, wy);
                chk_x = wx;
                chk_y = wy;
            } else if (t == 10) { // Slime 1
                level_map_set_tile(map, c, r, 0);
                en1 = entity_create_enemy(2, wx, wy, wx - (48.0 as f32), wx + (64.0 as f32));
            } else if (t == 11) { // Slime 2
                level_map_set_tile(map, c, r, 0);
                en2 = entity_create_enemy(3, wx, wy, wx - (48.0 as f32), wx + (64.0 as f32));
            } else if (t == 12) { // Drone
                level_map_set_tile(map, c, r, 0);
                drn = entity_create_drone(4, wx, wy);
            } else if (t == 13) { // Turret
                level_map_set_tile(map, c, r, 0);
                tur = entity_create_turret(5, wx, wy);
            } else if (t == 14) { // Boss
                level_map_set_tile(map, c, r, 0);
                bss = entity_create_boss(6, wx, wy);
            } else if (t == 15) { // Moving Platform
                level_map_set_tile(map, c, r, 0);
                plt = entity_create_platform(7, wx, wy, wx - (40.0 as f32), wx + (60.0 as f32), 45.0 as f32);
            }
            c = c + 1;
        }
        r = r + 1;
    }

    let empty_p = Particle {
        pos_x: 0.0 as f32, pos_y: 0.0 as f32, vel_x: 0.0 as f32, vel_y: 0.0 as f32,
        life: 0.0 as f32, max_life: 0.0 as f32, color: 0, active: false,
    };

    let grid = spatial_grid_create(640, 480);

    return PlatformerGame {
        player: ply,
        enemy_1: en1,
        enemy_2: en2,
        drone: drn,
        turret: tur,
        bullet: entity_create_empty(9),
        boss: bss,
        platform: plt,
        checkpoint: chk,
        p0: empty_p, p1: empty_p, p2: empty_p, p3: empty_p,
        p4: empty_p, p5: empty_p, p6: empty_p, p7: empty_p,
        p8: empty_p, p9: empty_p, p10: empty_p, p11: empty_p,
        p12: empty_p, p13: empty_p, p14: empty_p, p15: empty_p,
        level_idx: level_idx,
        camera_x: 0.0 as f32,
        camera_y: 0.0 as f32,
        score: 0,
        coins: 0,
        is_level_cleared: false,
        is_game_over: false,
        cloud_scroll: 0.0 as f32,
        jump_buffer_timer: 0.0 as f32,
        hitstop_timer: 0.0 as f32,
        shake_intensity: 0.0 as f32,
        shake_offset_x: 0.0 as f32,
        shake_offset_y: 0.0 as f32,
        checkpoint_x: chk_x,
        checkpoint_y: chk_y,
        spatial_grid: grid,
        torch_timer: 0.0 as f32,
        boss_music_started: false,
        level_title: info.title,
        biome: info.biome,
        has_lighting: info.has_lighting,
    };
}

// ----------------------------------------------------------------------------
// Particle Spawning Pipeline
// ----------------------------------------------------------------------------

fn game_spawn_particle(game: PlatformerGame, x: f32, y: f32, vx: f32, vy: f32, life: f32, color: i32): PlatformerGame {
    mut g: PlatformerGame = game;
    let p = particle_create(x, y, vx, vy, life, color);
    if (!g.p0.active) { g.p0 = p; }
    else if (!g.p1.active) { g.p1 = p; }
    else if (!g.p2.active) { g.p2 = p; }
    else if (!g.p3.active) { g.p3 = p; }
    else if (!g.p4.active) { g.p4 = p; }
    else if (!g.p5.active) { g.p5 = p; }
    else if (!g.p6.active) { g.p6 = p; }
    else if (!g.p7.active) { g.p7 = p; }
    else if (!g.p8.active) { g.p8 = p; }
    else if (!g.p9.active) { g.p9 = p; }
    else if (!g.p10.active) { g.p10 = p; }
    else if (!g.p11.active) { g.p11 = p; }
    else if (!g.p12.active) { g.p12 = p; }
    else if (!g.p13.active) { g.p13 = p; }
    else if (!g.p14.active) { g.p14 = p; }
    else if (!g.p15.active) { g.p15 = p; }
    return g;
}

fn game_spawn_dust_burst(game: PlatformerGame, x: f32, y: f32): PlatformerGame {
    mut g: PlatformerGame = game;
    let col: i32 = color_to_u32(ColorRGBA { r: 210, g: 215, b: 220, a: 220 });
    g = game_spawn_particle(g, x - (4.0 as f32), y, -50.0 as f32, -20.0 as f32, 0.22 as f32, col);
    g = game_spawn_particle(g, x + (4.0 as f32), y, 50.0 as f32, -20.0 as f32, 0.22 as f32, col);
    return g;
}

fn game_spawn_sparkles(game: PlatformerGame, x: f32, y: f32): PlatformerGame {
    mut g: PlatformerGame = game;
    let col: i32 = color_coin_gold();
    g = game_spawn_particle(g, x, y, -30.0 as f32, -70.0 as f32, 0.35 as f32, col);
    g = game_spawn_particle(g, x, y, 30.0 as f32, -70.0 as f32, 0.35 as f32, col);
    g = game_spawn_particle(g, x, y, 0.0 as f32, -90.0 as f32, 0.40 as f32, color_white());
    return g;
}

fn game_spawn_splatter(game: PlatformerGame, x: f32, y: f32, col: i32): PlatformerGame {
    mut g: PlatformerGame = game;
    g = game_spawn_particle(g, x, y, -60.0 as f32, -60.0 as f32, 0.30 as f32, col);
    g = game_spawn_particle(g, x, y, 60.0 as f32, -60.0 as f32, 0.30 as f32, col);
    g = game_spawn_particle(g, x, y, -20.0 as f32, -80.0 as f32, 0.35 as f32, col);
    g = game_spawn_particle(g, x, y, 20.0 as f32, -80.0 as f32, 0.35 as f32, col);
    return g;
}

// ----------------------------------------------------------------------------
// Physics Integration & Tile Collision with Juice & Moving Platforms
// ----------------------------------------------------------------------------

fn update_player_physics(game: PlatformerGame, map: LevelMap, input: InputState, dt: f32): PlatformerGame {
    mut g: PlatformerGame = game;
    mut p: Entity = g.player;

    // 1. Horizontal Input & Acceleration
    let move_accel: f32 = 1400.0 as f32;
    let max_speed: f32 = 160.0 as f32;
    mut friction: f32 = 4.0 as f32;
    if (p.is_grounded) {
        friction = 14.0 as f32;
    }

    if (input.left_down) {
        p.vel_x = p.vel_x - move_accel * dt;
        if (p.vel_x < -max_speed) { p.vel_x = -max_speed; }
        p.direction = -1.0 as f32;
        p.anim.flip_x = true;
    } else if (input.right_down) {
        p.vel_x = p.vel_x + move_accel * dt;
        if (p.vel_x > max_speed) { p.vel_x = max_speed; }
        p.direction = 1.0 as f32;
        p.anim.flip_x = false;
    } else {
        let drag: f32 = friction * dt;
        if (drag >= (1.0 as f32)) {
            p.vel_x = 0.0 as f32;
        } else {
            p.vel_x = p.vel_x * (1.0 as f32 - drag);
        }
    }

    // 2. Jump Buffering (0.12s window) & Coyote Time
    if (input.jump_pressed) {
        g.jump_buffer_timer = 0.12 as f32;
    } else if (g.jump_buffer_timer > (0.0 as f32)) {
        g.jump_buffer_timer = g.jump_buffer_timer - dt;
    }

    if (p.is_grounded) {
        p.coyote_timer = 0.12 as f32;
    } else {
        p.coyote_timer = p.coyote_timer - dt;
    }

    // Fire jump if buffered or just pressed while grounded/coyote
    if (g.jump_buffer_timer > (0.0 as f32) && (p.is_grounded || p.coyote_timer > (0.0 as f32))) {
        p.vel_y = -395.0 as f32;
        p.is_grounded = false;
        p.coyote_timer = 0.0 as f32;
        g.jump_buffer_timer = 0.0 as f32;

        // Juice: Stretch vertically on jump
        p.squash_x = 0.75 as f32;
        p.squash_y = 1.30 as f32;
        audio_play_jump();
        g = game_spawn_dust_burst(g, p.pos_x + (12.0 as f32), p.pos_y + (32.0 as f32));
    } else if (!input.jump_down && p.vel_y < (-100.0 as f32)) {
        // Variable jump height cut
        p.vel_y = p.vel_y * (0.65 as f32);
    }

    // 3. Gravity
    let gravity: f32 = 980.0 as f32;
    p.vel_y = p.vel_y + gravity * dt;
    if (p.vel_y > (650.0 as f32)) { p.vel_y = 650.0 as f32; }

    // 4. Horizontal Integration & Tile Collision
    let next_x: f32 = p.pos_x + p.vel_x * dt;
    let col_left: i32 = ((next_x + p.col_offset_x) / (16.0 as f32)) as i32;
    let col_right: i32 = ((next_x + p.col_offset_x + p.col_width) / (16.0 as f32)) as i32;
    let col_top: i32 = ((p.pos_y + p.col_offset_y) / (16.0 as f32)) as i32;
    let col_bottom: i32 = ((p.pos_y + p.col_offset_y + p.col_height - (1.0 as f32)) / (16.0 as f32)) as i32;

    mut blocked_x: bool = false;
    if (p.vel_x > (0.0 as f32)) {
        mut r: i32 = col_top;
        while (r <= col_bottom) {
            let t: i32 = level_map_get_tile(map, col_right, r);
            if (tile_is_solid(t) || t == 8) {
                blocked_x = true;
                p.pos_x = (col_right * 16) as f32 - p.col_offset_x - p.col_width;
                p.vel_x = 0.0 as f32;
            }
            r = r + 1;
        }
    } else if (p.vel_x < (0.0 as f32)) {
        mut r: i32 = col_top;
        while (r <= col_bottom) {
            let t: i32 = level_map_get_tile(map, col_left, r);
            if (tile_is_solid(t) || t == 8) {
                blocked_x = true;
                p.pos_x = ((col_left + 1) * 16) as f32 - p.col_offset_x;
                p.vel_x = 0.0 as f32;
            }
            r = r + 1;
        }
    }
    if (!blocked_x) {
        p.pos_x = next_x;
    }

    if (p.pos_x < (0.0 as f32)) { p.pos_x = 0.0 as f32; p.vel_x = 0.0 as f32; }
    if (p.pos_x > (624.0 as f32)) { p.pos_x = 624.0 as f32; p.vel_x = 0.0 as f32; }

    // 5. Vertical Integration & Tile Collision
    let was_grounded_before: bool = p.is_grounded;
    let next_y: f32 = p.pos_y + p.vel_y * dt;
    let cur_left: i32 = ((p.pos_x + p.col_offset_x) / (16.0 as f32)) as i32;
    let cur_right: i32 = ((p.pos_x + p.col_offset_x + p.col_width) / (16.0 as f32)) as i32;
    let v_top: i32 = ((next_y + p.col_offset_y) / (16.0 as f32)) as i32;
    let v_bottom: i32 = ((next_y + p.col_offset_y + p.col_height) / (16.0 as f32)) as i32;

    mut grounded: bool = false;
    if (p.vel_y >= (0.0 as f32)) {
        mut c: i32 = cur_left;
        while (c <= cur_right) {
            let t: i32 = level_map_get_tile(map, c, v_bottom);
            if (tile_is_solid(t) || t == 8) {
                grounded = true;
                p.pos_y = (v_bottom * 16) as f32 - p.col_offset_y - p.col_height;
                p.vel_y = 0.0 as f32;
                if (t == 8) {
                    audio_play_crumble();
                }
            }
            c = c + 1;
        }
    } else if (p.vel_y < (0.0 as f32)) {
        mut c: i32 = cur_left;
        while (c <= cur_right) {
            let t: i32 = level_map_get_tile(map, c, v_top);
            if (tile_is_solid(t) || t == 8) {
                p.pos_y = ((v_top + 1) * 16) as f32 - p.col_offset_y;
                p.vel_y = 0.0 as f32;
            }
            c = c + 1;
        }
    }

    // Moving platform velocity inheritance
    if (g.platform.active) {
        let plat_box: AABB = entity_get_collider_aabb(g.platform);
        let feet_y: f32 = p.pos_y + p.col_offset_y + p.col_height;
        let px_center: f32 = p.pos_x + (12.0 as f32);
        if (p.vel_y >= (0.0 as f32) && px_center >= plat_box.min_x && px_center <= plat_box.max_x &&
            feet_y >= plat_box.min_y && feet_y <= (plat_box.min_y + 10.0 as f32)) {
            grounded = true;
            p.pos_y = plat_box.min_y - p.col_offset_y - p.col_height;
            p.vel_y = 0.0 as f32;
            p.pos_x = p.pos_x + g.platform.vel_x * dt; // inherit motion!
        }
    }

    if (!grounded) {
        p.pos_y = next_y;
    }
    p.is_grounded = grounded;

    // Juice: Squash on ground impact
    if (!was_grounded_before && grounded) {
        p.squash_x = 1.30 as f32;
        p.squash_y = 0.70 as f32;
        g = game_spawn_dust_burst(g, p.pos_x + (12.0 as f32), p.pos_y + (32.0 as f32));
    }

    // Lerp squash & stretch back to 1.0 smoothly
    p.squash_x = p.squash_x + ((1.0 as f32) - p.squash_x) * (14.0 as f32) * dt;
    p.squash_y = p.squash_y + ((1.0 as f32) - p.squash_y) * (14.0 as f32) * dt;

    // Respawn from Checkpoint on bottom abyss fall
    if (p.pos_y > (460.0 as f32)) {
        p.pos_x = g.checkpoint_x;
        p.pos_y = g.checkpoint_y;
        p.vel_x = 0.0 as f32;
        p.vel_y = 0.0 as f32;
        p.health = p.health - 1;
        g.hitstop_timer = 0.08 as f32;
        g.shake_intensity = 8.0 as f32;
        audio_play_hurt();
    }

    // Animation state
    if (!p.is_grounded) {
        p.anim = animation_play(p.anim, anim_clip_jump());
    } else if (p.vel_x > (10.0 as f32) || p.vel_x < (-10.0 as f32)) {
        p.anim = animation_play(p.anim, anim_clip_run());
    } else {
        p.anim = animation_play(p.anim, anim_clip_idle());
    }
    p.anim = animation_update(p.anim, dt);

    if (p.invincible_timer > (0.0 as f32)) {
        p.invincible_timer = p.invincible_timer - dt;
    }

    g.player = p;
    return g;
}

// ----------------------------------------------------------------------------
// Reactive Enemy AI: Slime FSM (Patrol -> Alert -> Chase) & Flying Drone
// ----------------------------------------------------------------------------

fn update_enemy_ai(en: Entity, player: Entity, map: LevelMap, dt: f32): Entity {
    if (!en.active) {
        return en;
    }
    mut e: Entity = en;

    let dist_x: f32 = player.pos_x - e.pos_x;
    let dist_y: f32 = player.pos_y - e.pos_y;
    mut abs_dx: f32 = dist_x;
    if (abs_dx < (0.0 as f32)) { abs_dx = -abs_dx; }
    mut abs_dy: f32 = dist_y;
    if (abs_dy < (0.0 as f32)) { abs_dy = -abs_dy; }

    if (e.entity_type == entity_type_enemy()) {
        // FSM: Slime
        if (e.ai_state == ai_state_patrol()) {
            if (abs_dx < (160.0 as f32) && abs_dy < (40.0 as f32)) {
                e.ai_state = ai_state_alert();
                e.ai_timer = 0.35 as f32; // brief pause with ! alert icon
            } else {
                let next_x: f32 = e.pos_x + e.vel_x * dt;
                if (e.vel_x > (0.0 as f32)) {
                    if (next_x >= e.patrol_max) { e.vel_x = -40.0 as f32; e.anim.flip_x = true; }
                    else { e.pos_x = next_x; }
                } else {
                    if (next_x <= e.patrol_min) { e.vel_x = 40.0 as f32; e.anim.flip_x = false; }
                    else { e.pos_x = next_x; }
                }
            }
        } else if (e.ai_state == ai_state_alert()) {
            e.ai_timer = e.ai_timer - dt;
            if (e.ai_timer <= (0.0 as f32)) {
                e.ai_state = ai_state_chase();
            }
        } else if (e.ai_state == ai_state_chase()) {
            // Speed up and charge toward player
            let chase_speed: f32 = 72.0 as f32;
            if (dist_x > (0.0 as f32)) {
                e.vel_x = chase_speed;
                e.anim.flip_x = false;
            } else {
                e.vel_x = -chase_speed;
                e.anim.flip_x = true;
            }
            e.pos_x = e.pos_x + e.vel_x * dt;

            // Return to patrol if player escaped range
            if (abs_dx > (220.0 as f32)) {
                e.ai_state = ai_state_patrol();
                e.vel_x = 40.0 as f32;
            }
        }
    } else if (e.entity_type == entity_type_drone()) {
        // Flying Drone: Steering Seek toward player with sinusoidal hover
        let steer_speed: f32 = 65.0 as f32;
        mut dir_x: f32 = -1.0 as f32;
        if (dist_x > (0.0 as f32)) { dir_x = 1.0 as f32; }
        mut dir_y: f32 = -1.0 as f32;
        if (dist_y > (0.0 as f32)) { dir_y = 1.0 as f32; }
        e.pos_x = e.pos_x + dir_x * steer_speed * dt;
        e.pos_y = e.pos_y + dir_y * (steer_speed * (0.6 as f32)) * dt;
        e.anim.flip_x = (dir_x < (0.0 as f32));
    }

    e.anim = animation_update(e.anim, dt);
    return e;
}

// ----------------------------------------------------------------------------
// Sky Knight Mini-Boss & Predictive Turret Systems
// ----------------------------------------------------------------------------

fn update_boss_ai(boss: Entity, player: Entity, dt: f32): Entity {
    if (!boss.active) {
        return boss;
    }
    mut b: Entity = boss;

    let dist_x: f32 = player.pos_x - b.pos_x;
    mut is_phase2: bool = false;
    if (b.health <= 4) { is_phase2 = true; }
    if (is_phase2) { b.phase = 2; } else { b.phase = 1; }

    mut dash_speed: f32 = 65.0 as f32;
    if (is_phase2) { dash_speed = 95.0 as f32; }

    // Boss dash & jump
    b.pos_x = b.pos_x + b.direction * dash_speed * dt;
    if (b.pos_x >= b.patrol_max) {
        b.direction = -1.0 as f32;
        b.anim.flip_x = true;
    } else if (b.pos_x <= b.patrol_min) {
        b.direction = 1.0 as f32;
        b.anim.flip_x = false;
    }

    // Periodic leap attack
    b.shoot_timer = b.shoot_timer - dt;
    if (b.shoot_timer <= (0.0 as f32) && b.is_grounded) {
        b.vel_y = -350.0 as f32;
        b.is_grounded = false;
        if (is_phase2) {
            b.shoot_timer = 1.8 as f32;
        } else {
            b.shoot_timer = 3.0 as f32;
        }
    }

    // Gravity for boss
    b.vel_y = b.vel_y + (900.0 as f32) * dt;
    b.pos_y = b.pos_y + b.vel_y * dt;
    if (b.pos_y >= (96.0 as f32)) {
        b.pos_y = 96.0 as f32;
        b.vel_y = 0.0 as f32;
        b.is_grounded = true;
    }

    b.anim = animation_update(b.anim, dt);
    return b;
}

// ----------------------------------------------------------------------------
// Collectible, Hazard, Checkpoint & Combat Resolution
// ----------------------------------------------------------------------------

fn platformer_game_update(game: PlatformerGame, map: LevelMap, input: InputState, dt: f32): PlatformerGame {
    if (game.is_game_over || game.is_level_cleared) {
        return game;
    }

    mut g: PlatformerGame = game;

    // Handle Mute Toggle (Key 'M')
    if (input.mute_pressed) {
        audio_toggle_mute();
    }

    // Hit-stop simulation pause
    if (g.hitstop_timer > (0.0 as f32)) {
        g.hitstop_timer = g.hitstop_timer - dt;
        // Screen shake decay during hitstop
        g.shake_intensity = g.shake_intensity * (0.85 as f32);
        if (g.shake_intensity < (0.2 as f32)) { g.shake_intensity = 0.0 as f32; }
        return g;
    }

    // Screen shake decay
    g.shake_intensity = g.shake_intensity * (0.85 as f32);
    if (g.shake_intensity < (0.2 as f32)) { g.shake_intensity = 0.0 as f32; }

    // 1. Moving Platform Update
    if (g.platform.active) {
        g.platform.pos_x = g.platform.pos_x + g.platform.vel_x * dt;
        if (g.platform.pos_x >= g.platform.patrol_max) {
            g.platform.vel_x = -g.platform.vel_x;
        } else if (g.platform.pos_x <= g.platform.patrol_min) {
            g.platform.vel_x = -g.platform.vel_x;
        }
    }

    // 2. Player Physics & Collisions
    g = update_player_physics(g, map, input, dt);

    // 3. Enemy AI
    g.enemy_1 = update_enemy_ai(g.enemy_1, g.player, map, dt);
    g.enemy_2 = update_enemy_ai(g.enemy_2, g.player, map, dt);
    g.drone = update_enemy_ai(g.drone, g.player, map, dt);

    // 4. Boss Arena Activation & AI
    if (g.boss.active) {
        if (!g.boss_music_started && g.player.pos_x > (400.0 as f32)) {
            g.boss_music_started = true;
            audio_set_bgm(4); // Trigger intense Boss theme!
        }
        g.boss = update_boss_ai(g.boss, g.player, dt);
    }

    // 5. Predictive Turret Shooting
    if (g.turret.active && !g.bullet.active) {
        g.turret.shoot_timer = g.turret.shoot_timer - dt;
        if (g.turret.shoot_timer <= (0.0 as f32)) {
            g.turret.shoot_timer = 2.2 as f32;
            // Lead aim calculation
            let flight_time: f32 = 0.6 as f32;
            let aim_x: f32 = g.player.pos_x + g.player.vel_x * flight_time;
            let aim_y: f32 = g.player.pos_y;
            let dx: f32 = aim_x - g.turret.pos_x;
            let dy: f32 = aim_y - g.turret.pos_y;
            let speed: f32 = 180.0 as f32;
            mut vx: f32 = -speed;
            if (dx > (0.0 as f32)) { vx = speed; }
            g.bullet = entity_create_bullet(9, g.turret.pos_x, g.turret.pos_y + (4.0 as f32), vx, 0.0 as f32);
            audio_play_laser();
        }
    }

    // Bullet update
    if (g.bullet.active) {
        g.bullet.pos_x = g.bullet.pos_x + g.bullet.vel_x * dt;
        g.bullet.ai_timer = g.bullet.ai_timer - dt;
        if (g.bullet.ai_timer <= (0.0 as f32) || g.bullet.pos_x < (0.0 as f32) || g.bullet.pos_x > (640.0 as f32)) {
            g.bullet.active = false;
        } else {
            // Bullet vs Player
            let b_box: AABB = entity_get_collider_aabb(g.bullet);
            let p_box: AABB = entity_get_collider_aabb(g.player);
            if (aabb_intersects(b_box, p_box) && g.player.invincible_timer <= (0.0 as f32)) {
                g.player.health = g.player.health - 1;
                g.player.invincible_timer = 1.0 as f32;
                g.bullet.active = false;
                g.hitstop_timer = 0.06 as f32;
                g.shake_intensity = 6.0 as f32;
                audio_play_hurt();
            }
        }
    }

    // 6. Tile Triggers (Coins, Springs, Spikes, Flag, Checkpoint)
    let p_box: AABB = entity_get_collider_aabb(g.player);
    let start_col: i32 = (p_box.min_x / (16.0 as f32)) as i32;
    let end_col: i32 = (p_box.max_x / (16.0 as f32)) as i32;
    let start_row: i32 = (p_box.min_y / (16.0 as f32)) as i32;
    let end_row: i32 = (p_box.max_y / (16.0 as f32)) as i32;

    mut r: i32 = start_row;
    while (r <= end_row) {
        mut c: i32 = start_col;
        while (c <= end_col) {
            let tile: i32 = level_map_get_tile(map, c, r);
            if (tile_is_coin(tile)) {
                level_map_set_tile(map, c, r, 0);
                g.coins = g.coins + 1;
                g.score = g.score + 50;
                audio_play_coin();
                g = game_spawn_sparkles(g, (c * 16 + 8) as f32, (r * 16 + 8) as f32);
            } else if (tile_is_spring(tile)) {
                g.player.vel_y = -560.0 as f32;
                g.player.is_grounded = false;
                g.player.squash_x = 0.65 as f32;
                g.player.squash_y = 1.45 as f32;
                audio_play_spring();
            } else if (tile_is_hazard(tile)) {
                if (g.player.invincible_timer <= (0.0 as f32)) {
                    g.player.health = g.player.health - 1;
                    g.player.vel_y = -300.0 as f32;
                    g.player.invincible_timer = 1.0 as f32;
                    g.hitstop_timer = 0.08 as f32;
                    g.shake_intensity = 8.0 as f32;
                    audio_play_hurt();
                }
            } else if (tile_is_goal(tile)) {
                if (!g.is_level_cleared) {
                    g.is_level_cleared = true;
                    g.score = g.score + 500;
                    audio_play_victory();
                }
            } else if (tile == 9) { // Checkpoint tile touched
                g.checkpoint_x = (c * 16) as f32;
                g.checkpoint_y = (r * 16) as f32;
                level_map_set_tile(map, c, r, 0); // Activate
                audio_play_coin();
                g = game_spawn_sparkles(g, g.checkpoint_x + (8.0 as f32), g.checkpoint_y + (8.0 as f32));
            }
            c = c + 1;
        }
        r = r + 1;
    }

    // 7. Player vs Slimes & Drone Combat
    if (g.enemy_1.active) {
        let e_box: AABB = entity_get_collider_aabb(g.enemy_1);
        if (aabb_intersects(p_box, e_box)) {
            if (g.player.vel_y > (50.0 as f32) && p_box.max_y <= (e_box.min_y + 8.0 as f32)) {
                g.enemy_1.active = false;
                g.player.vel_y = -320.0 as f32;
                g.score = g.score + 100;
                g.hitstop_timer = 0.05 as f32;
                g.shake_intensity = 4.0 as f32;
                audio_play_stomp();
                g = game_spawn_splatter(g, g.enemy_1.pos_x + (8.0 as f32), g.enemy_1.pos_y + (8.0 as f32), color_magenta());
            } else if (g.player.invincible_timer <= (0.0 as f32)) {
                g.player.health = g.player.health - 1;
                g.player.invincible_timer = 1.0 as f32;
                g.hitstop_timer = 0.08 as f32;
                g.shake_intensity = 6.0 as f32;
                audio_play_hurt();
            }
        }
    }

    if (g.enemy_2.active) {
        let e_box: AABB = entity_get_collider_aabb(g.enemy_2);
        if (aabb_intersects(p_box, e_box)) {
            if (g.player.vel_y > (50.0 as f32) && p_box.max_y <= (e_box.min_y + 8.0 as f32)) {
                g.enemy_2.active = false;
                g.player.vel_y = -320.0 as f32;
                g.score = g.score + 100;
                g.hitstop_timer = 0.05 as f32;
                g.shake_intensity = 4.0 as f32;
                audio_play_stomp();
                g = game_spawn_splatter(g, g.enemy_2.pos_x + (8.0 as f32), g.enemy_2.pos_y + (8.0 as f32), color_magenta());
            } else if (g.player.invincible_timer <= (0.0 as f32)) {
                g.player.health = g.player.health - 1;
                g.player.invincible_timer = 1.0 as f32;
                g.hitstop_timer = 0.08 as f32;
                g.shake_intensity = 6.0 as f32;
                audio_play_hurt();
            }
        }
    }

    if (g.drone.active) {
        let d_box: AABB = entity_get_collider_aabb(g.drone);
        if (aabb_intersects(p_box, d_box)) {
            if (g.player.vel_y > (50.0 as f32) && p_box.max_y <= (d_box.min_y + 8.0 as f32)) {
                g.drone.active = false;
                g.player.vel_y = -340.0 as f32;
                g.score = g.score + 150;
                g.hitstop_timer = 0.05 as f32;
                g.shake_intensity = 4.0 as f32;
                audio_play_stomp();
                g = game_spawn_splatter(g, g.drone.pos_x + (8.0 as f32), g.drone.pos_y + (8.0 as f32), color_cyan());
            } else if (g.player.invincible_timer <= (0.0 as f32)) {
                g.player.health = g.player.health - 1;
                g.player.invincible_timer = 1.0 as f32;
                g.hitstop_timer = 0.08 as f32;
                g.shake_intensity = 6.0 as f32;
                audio_play_hurt();
            }
        }
    }

    // 8. Player vs Sky Knight Boss Combat
    if (g.boss.active) {
        let b_box: AABB = entity_get_collider_aabb(g.boss);
        if (aabb_intersects(p_box, b_box)) {
            if (g.player.vel_y > (50.0 as f32) && p_box.max_y <= (b_box.min_y + 12.0 as f32)) {
                g.boss.health = g.boss.health - 1;
                g.player.vel_y = -360.0 as f32;
                g.hitstop_timer = 0.08 as f32;
                g.shake_intensity = 9.0 as f32;
                audio_play_boss_hit();
                g = game_spawn_splatter(g, g.boss.pos_x + (12.0 as f32), g.boss.pos_y + (16.0 as f32), color_red());

                if (g.boss.health <= 0) {
                    g.boss.active = false;
                    g.score = g.score + 1000;
                    g.is_level_cleared = true;
                    audio_play_victory();
                }
            } else if (g.player.invincible_timer <= (0.0 as f32)) {
                g.player.health = g.player.health - 1;
                g.player.invincible_timer = 1.2 as f32;
                g.hitstop_timer = 0.08 as f32;
                g.shake_intensity = 8.0 as f32;
                audio_play_hurt();
            }
        }
    }

    if (g.player.health <= 0) {
        g.is_game_over = true;
    }

    // 9. Particles simulation step
    g.p0 = particle_update(g.p0, dt); g.p1 = particle_update(g.p1, dt);
    g.p2 = particle_update(g.p2, dt); g.p3 = particle_update(g.p3, dt);
    g.p4 = particle_update(g.p4, dt); g.p5 = particle_update(g.p5, dt);
    g.p6 = particle_update(g.p6, dt); g.p7 = particle_update(g.p7, dt);
    g.p8 = particle_update(g.p8, dt); g.p9 = particle_update(g.p9, dt);
    g.p10 = particle_update(g.p10, dt); g.p11 = particle_update(g.p11, dt);
    g.p12 = particle_update(g.p12, dt); g.p13 = particle_update(g.p13, dt);
    g.p14 = particle_update(g.p14, dt); g.p15 = particle_update(g.p15, dt);

    // 10. Background Cloud Drift
    g.cloud_scroll = g.cloud_scroll + dt * (15.0 as f32);
    if (g.cloud_scroll >= (640.0 as f32)) {
        g.cloud_scroll = g.cloud_scroll - (640.0 as f32);
    }

    return g;
}

// ----------------------------------------------------------------------------
// Rendering Pipeline: Dynamic Auto-Tiling, Entities, SIMD 2D Lighting, HUD
// ----------------------------------------------------------------------------

fn platformer_game_render(ce: CanvasEngine, atlas: Texture, game: PlatformerGame, map: LevelMap, fps: i32, frame_time_ms: f32): void {
    // 1. Sky & Parallax Background
    mut sky_col: i32 = color_to_u32(ColorRGBA { r: 160, g: 70, b: 140, a: 255 });
    if (game.biome == 0) {
        sky_col = color_sky_blue();
    } else if (game.biome == 1) {
        sky_col = color_to_u32(ColorRGBA { r: 35, g: 40, b: 55, a: 255 }); // Dark cavern
    } else if (game.biome == 2) {
        sky_col = color_to_u32(ColorRGBA { r: 160, g: 70, b: 140, a: 255 }); // Twilight sky
    } else if (game.biome == 3) {
        sky_col = color_to_u32(ColorRGBA { r: 35, g: 20, b: 35, a: 255 }); // Volcanic boss arena
    }
    canvas_engine_clear(ce, sky_col);

    if (game.biome != 1) {
        // Floating clouds
        let c_offset: i32 = (game.cloud_scroll as i32);
        canvas_engine_fill_circle(ce, ((c_offset + 80) % 700) - 50, 60, 24, color_white());
        canvas_engine_fill_circle(ce, ((c_offset + 105) % 700) - 50, 52, 28, color_white());
        canvas_engine_fill_circle(ce, ((c_offset + 130) % 700) - 50, 60, 22, color_white());
        canvas_engine_fill_circle(ce, ((c_offset + 420) % 700) - 50, 90, 26, color_white());
        canvas_engine_fill_circle(ce, ((c_offset + 450) % 700) - 50, 80, 32, color_white());

        // Mountain silhouette
        mut mx: i32 = 0;
        let mtn_col: i32 = color_to_u32(ColorRGBA { r: 90, g: 140, b: 180, a: 255 });
        while (mx < 640) {
            canvas_engine_fill_rect(ce, mx, 220 + ((mx % 60) / 3), 1, 260, mtn_col);
            mx = mx + 1;
        }
    }

    // 2. Tilemap Rendering with 4-Bit Auto-Tiling
    mut r: i32 = 0;
    while (r < (map.rows - 2)) {
        mut c: i32 = 0;
        while (c < map.cols) {
            let t: i32 = level_map_get_tile(map, c, r);
            if (t > 0) {
                let px: i32 = c * 16;
                let py: i32 = r * 16;

                if (t == 1) { // Grass with dynamic edge auto-tiling
                    let mask: i32 = auto_tile_get_bitmask(map, c, r);
                    if ((mask & 1) == 0) {
                        sprite_blit(ce, atlas, 16, 0, 16, 16, px, py, false); // top lush grass
                    } else {
                        sprite_blit(ce, atlas, 32, 0, 16, 16, px, py, false); // subsurface dirt
                    }
                } else if (t == 2) { // Dirt
                    sprite_blit(ce, atlas, 32, 0, 16, 16, px, py, false);
                } else if (t == 3) { // Stone
                    sprite_blit(ce, atlas, 48, 0, 16, 16, px, py, false);
                } else if (t == 4) { // Coin
                    sprite_blit(ce, atlas, 64, 0, 16, 16, px, py, false);
                } else if (t == 5) { // Spikes
                    sprite_blit(ce, atlas, 80, 0, 16, 16, px, py, false);
                } else if (t == 6) { // Spring
                    sprite_blit(ce, atlas, 96, 0, 16, 16, px, py, false);
                } else if (t == 7) { // Flag
                    sprite_blit(ce, atlas, 112, 0, 16, 16, px, py, false);
                } else if (t == 8) { // Crumbling Block
                    sprite_blit(ce, atlas, 80, 32, 16, 16, px, py, false);
                } else if (t == 9) { // Checkpoint Flag
                    sprite_blit(ce, atlas, 96, 32, 16, 24, px, py - 8, false);
                }
            }
            c = c + 1;
        }
        r = r + 1;
    }

    // 3. Moving Platform
    if (game.platform.active) {
        let plx: i32 = game.platform.pos_x as i32;
        let ply_pos: i32 = game.platform.pos_y as i32;
        sprite_blit(ce, atlas, 48, 32, 32, 12, plx, ply_pos, false);
    }

    // 4. Enemy Entities & Alert Overlays
    if (game.enemy_1.active) {
        let ex: i32 = game.enemy_1.pos_x as i32;
        let ey: i32 = game.enemy_1.pos_y as i32;
        sprite_blit(ce, atlas, 48, 16, 16, 16, ex, ey, game.enemy_1.anim.flip_x);
        if (game.enemy_1.ai_state == ai_state_alert()) {
            canvas_engine_draw_text(ce, ex + 4, ey - 14, "!", color_yellow(), 1);
        }
    }
    if (game.enemy_2.active) {
        let ex: i32 = game.enemy_2.pos_x as i32;
        let ey: i32 = game.enemy_2.pos_y as i32;
        sprite_blit(ce, atlas, 48, 16, 16, 16, ex, ey, game.enemy_2.anim.flip_x);
        if (game.enemy_2.ai_state == ai_state_alert()) {
            canvas_engine_draw_text(ce, ex + 4, ey - 14, "!", color_yellow(), 1);
        }
    }
    if (game.drone.active) {
        let dx: i32 = game.drone.pos_x as i32;
        let dy: i32 = game.drone.pos_y as i32;
        sprite_blit(ce, atlas, 80, 16, 16, 16, dx, dy, game.drone.anim.flip_x);
    }
    if (game.turret.active) {
        let tx: i32 = game.turret.pos_x as i32;
        let ty: i32 = game.turret.pos_y as i32;
        sprite_blit(ce, atlas, 96, 16, 16, 16, tx, ty, false);
    }
    if (game.bullet.active) {
        let bx: i32 = game.bullet.pos_x as i32;
        let by: i32 = game.bullet.pos_y as i32;
        sprite_blit(ce, atlas, 112, 32, 8, 8, bx, by, false);
    }
    if (game.boss.active) {
        let bx: i32 = game.boss.pos_x as i32;
        let by: i32 = game.boss.pos_y as i32;
        sprite_blit(ce, atlas, 0, 32, 24, 32, bx, by, game.boss.anim.flip_x);
        // Boss Health Bar above boss
        let bar_w: i32 = 40;
        let hp_w: i32 = (bar_w * game.boss.health) / 8;
        canvas_engine_fill_rect(ce, bx - 8, by - 8, bar_w, 4, color_black());
        mut boss_hp_col: i32 = color_coin_gold();
        if (game.boss.phase == 2) {
            boss_hp_col = color_red();
        }
        canvas_engine_fill_rect(ce, bx - 8, by - 8, hp_w, 4, boss_hp_col);
    }

    // 5. Player Rendering with Squash & Stretch
    let inv: bool = (game.player.invincible_timer > (0.0 as f32));
    mut show_player: bool = true;
    if (inv) {
        let flash_tick: i32 = ((game.player.invincible_timer * (15.0 as f32)) as i32) % 2;
        show_player = (flash_tick == 0);
    }
    if (show_player) {
        let pw: i32 = (24.0 as f32 * game.player.squash_x) as i32;
        let ph: i32 = (32.0 as f32 * game.player.squash_y) as i32;
        let px: i32 = (game.player.pos_x - ((pw - 24) / 2) as f32) as i32;
        let py: i32 = (game.player.pos_y - (ph - 32) as f32) as i32;
        let coords: Vec2i = animation_get_atlas_coords(game.player.anim);
        sprite_blit_scaled(ce, atlas, coords.x, coords.y, 24, 32, px, py, pw, ph, game.player.anim.flip_x);
    }

    // 6. Reactive Particles Rendering
    let p_arr0 = game.p0; if (p_arr0.active) { canvas_engine_fill_circle(ce, p_arr0.pos_x as i32, p_arr0.pos_y as i32, 2, p_arr0.color); }
    let p_arr1 = game.p1; if (p_arr1.active) { canvas_engine_fill_circle(ce, p_arr1.pos_x as i32, p_arr1.pos_y as i32, 2, p_arr1.color); }
    let p_arr2 = game.p2; if (p_arr2.active) { canvas_engine_fill_circle(ce, p_arr2.pos_x as i32, p_arr2.pos_y as i32, 2, p_arr2.color); }
    let p_arr3 = game.p3; if (p_arr3.active) { canvas_engine_fill_circle(ce, p_arr3.pos_x as i32, p_arr3.pos_y as i32, 2, p_arr3.color); }
    let p_arr4 = game.p4; if (p_arr4.active) { canvas_engine_fill_circle(ce, p_arr4.pos_x as i32, p_arr4.pos_y as i32, 2, p_arr4.color); }
    let p_arr5 = game.p5; if (p_arr5.active) { canvas_engine_fill_circle(ce, p_arr5.pos_x as i32, p_arr5.pos_y as i32, 2, p_arr5.color); }
    let p_arr6 = game.p6; if (p_arr6.active) { canvas_engine_fill_circle(ce, p_arr6.pos_x as i32, p_arr6.pos_y as i32, 2, p_arr6.color); }
    let p_arr7 = game.p7; if (p_arr7.active) { canvas_engine_fill_circle(ce, p_arr7.pos_x as i32, p_arr7.pos_y as i32, 2, p_arr7.color); }
    let p_arr8 = game.p8; if (p_arr8.active) { canvas_engine_fill_circle(ce, p_arr8.pos_x as i32, p_arr8.pos_y as i32, 2, p_arr8.color); }
    let p_arr9 = game.p9; if (p_arr9.active) { canvas_engine_fill_circle(ce, p_arr9.pos_x as i32, p_arr9.pos_y as i32, 2, p_arr9.color); }
    let p_arr10 = game.p10; if (p_arr10.active) { canvas_engine_fill_circle(ce, p_arr10.pos_x as i32, p_arr10.pos_y as i32, 2, p_arr10.color); }
    let p_arr11 = game.p11; if (p_arr11.active) { canvas_engine_fill_circle(ce, p_arr11.pos_x as i32, p_arr11.pos_y as i32, 2, p_arr11.color); }

    // 7. SIMD-Accelerated 2D Dynamic Lighting Pass
    if (game.has_lighting) {
        let light_bytes: i64 = (6 as i64) * (28 as i64); // 6 lights * 7 floats * 4 bytes
        let mem: *void = malloc(light_bytes);
        unsafe {
            let lptr: *f32 = mem as *f32;
            // Light 0: Player Lantern
            *(lptr as *f32) = game.player.pos_x + (12.0 as f32);
            *((lptr as i64 + (4 as i64)) as *f32) = game.player.pos_y + (16.0 as f32);
            *((lptr as i64 + (8 as i64)) as *f32) = 115.0 as f32; // radius
            *((lptr as i64 + (12 as i64)) as *f32) = 1.0 as f32;   // R
            *((lptr as i64 + (16 as i64)) as *f32) = 0.95 as f32;  // G
            *((lptr as i64 + (20 as i64)) as *f32) = 0.70 as f32;  // B
            *((lptr as i64 + (24 as i64)) as *f32) = 1.0 as f32;   // Intensity

            // Light 1: Checkpoint Glow
            let l1_offset: i64 = 28 as i64;
            *((lptr as i64 + l1_offset) as *f32) = game.checkpoint_x + (8.0 as f32);
            *((lptr as i64 + l1_offset + (4 as i64)) as *f32) = game.checkpoint_y + (8.0 as f32);
            *((lptr as i64 + l1_offset + (8 as i64)) as *f32) = 75.0 as f32;
            *((lptr as i64 + l1_offset + (12 as i64)) as *f32) = 0.3 as f32;
            *((lptr as i64 + l1_offset + (16 as i64)) as *f32) = 1.0 as f32;
            *((lptr as i64 + l1_offset + (20 as i64)) as *f32) = 0.5 as f32;
            *((lptr as i64 + l1_offset + (24 as i64)) as *f32) = 0.9 as f32;

            canvas_engine_apply_lighting(ce, mem, 2, 0.18 as f32, 0.20 as f32, 0.28 as f32);
            free(mem);
        }
    }

    // 8. Retro Top HUD Bar
    canvas_engine_fill_rect(ce, 0, 0, ce.width, 26, color_to_u32(ColorRGBA { r: 15, g: 20, b: 30, a: 220 }));
    canvas_engine_draw_line(ce, 0, 26, ce.width, 26, color_cyan());

    // Hearts
    mut h: i32 = 0;
    while (h < game.player.health) {
        sprite_blit(ce, atlas, 64, 16, 16, 16, 10 + (h * 18), 5, false);
        h = h + 1;
    }

    // Coins Counter
    sprite_blit(ce, atlas, 64, 0, 16, 16, 85, 5, false);
    mut coin_str: string = i32_to_string(game.coins);
    if (game.coins < 10) { coin_str = "0" + coin_str; }
    canvas_engine_draw_text(ce, 105, 9, "X " + coin_str, color_coin_gold(), 1);

    // Score
    canvas_engine_draw_text(ce, 160, 9, "SCORE:" + i32_to_string(game.score), color_white(), 1);

    // Level Title
    canvas_engine_draw_text(ce, 230, 9, game.level_title, color_yellow(), 1);

    // Telemetry: 60 FPS, Frame time, SIMD hardware acceleration & Audio synth status
    let fps_str: string = "FPS:" + i32_to_string(fps) + " SIMD:SSE2/AVX CHIPTUNE:4CH";
    canvas_engine_draw_text(ce, 430, 9, fps_str, color_cyan(), 1);

    // Bottom Help Banner
    canvas_engine_fill_rect(ce, 0, 456, ce.width, 24, color_to_u32(ColorRGBA { r: 15, g: 20, b: 30, a: 220 }));
    canvas_engine_draw_text(ce, 10, 463, "[A/D] MOVE  [SPACE] JUMP  [TAB] EDITOR  [F5] TEST  [M] MUTE  [F11] FULLSCREEN  [R] RESTART", color_light_gray(), 1);

    // Stage Clear / Game Over Overlays
    if (game.is_level_cleared) {
        canvas_engine_fill_rect(ce, 170, 180, 300, 100, color_to_u32(ColorRGBA { r: 10, g: 30, b: 20, a: 240 }));
        canvas_engine_draw_rect(ce, 170, 180, 300, 100, color_green());
        canvas_engine_draw_text(ce, 230, 205, "STAGE CLEAR!", color_yellow(), 2);
        canvas_engine_draw_text(ce, 210, 245, "PRESS ENTER FOR NEXT LEVEL", color_white(), 1);
    } else if (game.is_game_over) {
        canvas_engine_fill_rect(ce, 170, 180, 300, 100, color_to_u32(ColorRGBA { r: 40, g: 10, b: 15, a: 240 }));
        canvas_engine_draw_rect(ce, 170, 180, 300, 100, color_red());
        canvas_engine_draw_text(ce, 240, 205, "GAME OVER", color_red(), 2);
        canvas_engine_draw_text(ce, 215, 245, "PRESS [R] TO TRY AGAIN", color_white(), 1);
    }
}
