<?php

// ============================================================================
// SantientPHP Game Engine: Frame-Based Animation System
// Tests: Value Structs, State Machines, Delta-Time Frame Advancement
// ============================================================================

import "types.sph";

// Animation Clip identifiers
fn anim_clip_idle(): i32 { return 0; }
fn anim_clip_run(): i32 { return 1; }
fn anim_clip_jump(): i32 { return 2; }
fn anim_clip_fall(): i32 { return 3; }
fn anim_clip_coin(): i32 { return 4; }
fn anim_clip_slime(): i32 { return 5; }
fn anim_clip_drone(): i32 { return 6; }
fn anim_clip_turret(): i32 { return 7; }
fn anim_clip_boss(): i32 { return 8; }
fn anim_clip_platform(): i32 { return 9; }
fn anim_clip_crumble(): i32 { return 10; }
fn anim_clip_checkpoint(): i32 { return 11; }
fn anim_clip_bullet(): i32 { return 12; }

struct AnimationState {
    clip_id: i32,
    frame: i32,
    timer: f32,
    flip_x: bool,
    is_playing: bool,
}

fn animation_state_create(): AnimationState {
    return AnimationState {
        clip_id: anim_clip_idle(),
        frame: 0,
        timer: 0.0 as f32,
        flip_x: false,
        is_playing: true,
    };
}

fn animation_play(state: AnimationState, clip_id: i32): AnimationState {
    if (state.clip_id == clip_id) {
        return state;
    }
    return AnimationState {
        clip_id: clip_id,
        frame: 0,
        timer: 0.0 as f32,
        flip_x: state.flip_x,
        is_playing: true,
    };
}

fn animation_update(state: AnimationState, dt: f32): AnimationState {
    if (!state.is_playing) {
        return state;
    }

    mut next_timer: f32 = state.timer + dt;
    mut next_frame: i32 = state.frame;

    mut frame_duration: f32 = 0.15 as f32;
    mut max_frames: i32 = 2;

    if (state.clip_id == anim_clip_idle()) {
        frame_duration = 0.25 as f32;
        max_frames = 1;
    } else if (state.clip_id == anim_clip_run()) {
        frame_duration = 0.12 as f32;
        max_frames = 2;
    } else if (state.clip_id == anim_clip_jump()) {
        frame_duration = 1.0 as f32;
        max_frames = 1;
    } else if (state.clip_id == anim_clip_coin()) {
        frame_duration = 0.15 as f32;
        max_frames = 1;
    } else if (state.clip_id == anim_clip_slime()) {
        frame_duration = 0.20 as f32;
        max_frames = 1;
    } else if (state.clip_id == anim_clip_drone()) {
        frame_duration = 0.10 as f32;
        max_frames = 2;
    } else if (state.clip_id == anim_clip_boss()) {
        frame_duration = 0.15 as f32;
        max_frames = 2;
    }

    if (next_timer >= frame_duration) {
        next_timer = next_timer - frame_duration;
        next_frame = next_frame + 1;
        if (next_frame >= max_frames) {
            next_frame = 0;
        }
    }

    return AnimationState {
        clip_id: state.clip_id,
        frame: next_frame,
        timer: next_timer,
        flip_x: state.flip_x,
        is_playing: state.is_playing,
    };
}

// Maps current animation clip and frame to tile (x, y) on the 128x128 sprite atlas
fn animation_get_atlas_coords(state: AnimationState): Vec2i {
    if (state.clip_id == anim_clip_idle()) {
        return Vec2i { x: 0, y: 64 };
    }
    if (state.clip_id == anim_clip_run()) {
        mut tx: i32 = 24;
        if (state.frame == 1) {
            tx = 48;
        }
        return Vec2i { x: tx, y: 64 };
    }
    if (state.clip_id == anim_clip_jump() || state.clip_id == anim_clip_fall()) {
        return Vec2i { x: 72, y: 64 };
    }
    if (state.clip_id == anim_clip_coin()) {
        return Vec2i { x: 64, y: 0 };
    }
    if (state.clip_id == anim_clip_slime()) {
        return Vec2i { x: 48, y: 16 };
    }
    if (state.clip_id == anim_clip_drone()) {
        return Vec2i { x: 80, y: 16 };
    }
    if (state.clip_id == anim_clip_turret()) {
        return Vec2i { x: 96, y: 16 };
    }
    if (state.clip_id == anim_clip_boss()) {
        return Vec2i { x: 0, y: 32 };
    }
    if (state.clip_id == anim_clip_platform()) {
        return Vec2i { x: 48, y: 32 };
    }
    if (state.clip_id == anim_clip_crumble()) {
        return Vec2i { x: 80, y: 32 };
    }
    if (state.clip_id == anim_clip_checkpoint()) {
        return Vec2i { x: 96, y: 32 };
    }
    if (state.clip_id == anim_clip_bullet()) {
        return Vec2i { x: 112, y: 32 };
    }
    return Vec2i { x: 0, y: 0 };
}
