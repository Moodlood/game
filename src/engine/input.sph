<?php

// ============================================================================
// SantientPHP Game Engine: Low-Latency Win32 Input Handling
// Tests: Direct Win32 GetAsyncKeyState Polling, Edge Triggering, Mouse Coordinates
// ============================================================================

import "types.sph";
import "window.sph";
import "canvas.sph";

extern "C" fn GetAsyncKeyState(vKey: i32): i32;

// Virtual Key Codes
fn key_code_left(): i32 { return 37; }
fn key_code_up(): i32 { return 38; }
fn key_code_right(): i32 { return 39; }
fn key_code_down(): i32 { return 40; }
fn key_code_space(): i32 { return 32; }
fn key_code_enter(): i32 { return 13; }
fn key_code_escape(): i32 { return 27; }
fn key_code_tab(): i32 { return 9; }
fn key_code_f5(): i32 { return 116; }
fn key_code_f11(): i32 { return 122; }
fn key_code_ctrl(): i32 { return 17; }
fn key_code_a(): i32 { return 65; }
fn key_code_d(): i32 { return 68; }
fn key_code_w(): i32 { return 87; }
fn key_code_s(): i32 { return 83; }
fn key_code_e(): i32 { return 69; }
fn key_code_r(): i32 { return 82; }
fn key_code_z(): i32 { return 90; }
fn key_code_y(): i32 { return 89; }
fn key_code_m(): i32 { return 77; }
fn key_code_1(): i32 { return 49; }
fn key_code_2(): i32 { return 50; }
fn key_code_3(): i32 { return 51; }
fn key_code_4(): i32 { return 52; }
fn key_code_5(): i32 { return 53; }
fn key_code_6(): i32 { return 54; }
fn key_code_7(): i32 { return 55; }
fn key_code_8(): i32 { return 56; }
fn key_code_9(): i32 { return 57; }
fn key_code_lbutton(): i32 { return 1; }
fn key_code_rbutton(): i32 { return 2; }

struct InputState {
    left_down: bool,
    right_down: bool,
    up_down: bool,
    down_down: bool,
    jump_down: bool,
    jump_pressed: bool,
    editor_toggle_pressed: bool,
    reset_pressed: bool,
    fullscreen_toggle_pressed: bool,
    f5_pressed: bool,
    ctrl_down: bool,
    z_pressed: bool,
    y_pressed: bool,
    mute_pressed: bool,
    mouse_x: i32,
    mouse_y: i32,
    mouse_lbutton_down: bool,
    mouse_lbutton_pressed: bool,
    mouse_rbutton_down: bool,
    mouse_rbutton_pressed: bool,
    digit_pressed: i32,
}

fn input_is_raw_key_down(vk: i32): bool {
    let state: i32 = GetAsyncKeyState(vk);
    return (state & 32768) != 0;
}

fn input_poll(win: EngineWindow, ce: CanvasEngine, prev: InputState): InputState {
    let raw_left: bool = input_is_raw_key_down(key_code_left()) || input_is_raw_key_down(key_code_a());
    let raw_right: bool = input_is_raw_key_down(key_code_right()) || input_is_raw_key_down(key_code_d());
    let raw_up: bool = input_is_raw_key_down(key_code_up()) || input_is_raw_key_down(key_code_w());
    let raw_down: bool = input_is_raw_key_down(key_code_down()) || input_is_raw_key_down(key_code_s());
    let raw_jump: bool = input_is_raw_key_down(key_code_space()) || raw_up;

    let jump_just_pressed: bool = raw_jump && (!prev.jump_down);

    let raw_e: bool = input_is_raw_key_down(key_code_e()) || input_is_raw_key_down(key_code_tab());
    let raw_r: bool = input_is_raw_key_down(key_code_r());
    let raw_f11: bool = input_is_raw_key_down(key_code_f11());
    let raw_f5: bool = input_is_raw_key_down(key_code_f5());
    let raw_ctrl: bool = input_is_raw_key_down(key_code_ctrl());
    let raw_z: bool = input_is_raw_key_down(key_code_z());
    let raw_y: bool = input_is_raw_key_down(key_code_y());
    let raw_m: bool = input_is_raw_key_down(key_code_m());

    let f5_just_pressed: bool = raw_f5 && (!prev.f5_pressed);
    let z_just_pressed: bool = raw_z && (!prev.z_pressed);
    let y_just_pressed: bool = raw_y && (!prev.y_pressed);
    let m_just_pressed: bool = raw_m && (!prev.mute_pressed);

    // Mouse coordinates mapped to canvas space
    let raw_mpt: Vec2i = engine_window_get_mouse_client(win);
    let mpt: Vec2i = canvas_engine_map_mouse(ce, raw_mpt.x, raw_mpt.y);
    let raw_lmb: bool = input_is_raw_key_down(key_code_lbutton());
    let raw_rmb: bool = input_is_raw_key_down(key_code_rbutton());

    let lmb_just_pressed: bool = raw_lmb && (!prev.mouse_lbutton_down);
    let rmb_just_pressed: bool = raw_rmb && (!prev.mouse_rbutton_down);

    // Numeric brushes 1..9
    mut digit: i32 = 0;
    if (input_is_raw_key_down(key_code_1())) { digit = 1; }
    else if (input_is_raw_key_down(key_code_2())) { digit = 2; }
    else if (input_is_raw_key_down(key_code_3())) { digit = 3; }
    else if (input_is_raw_key_down(key_code_4())) { digit = 4; }
    else if (input_is_raw_key_down(key_code_5())) { digit = 5; }
    else if (input_is_raw_key_down(key_code_6())) { digit = 6; }
    else if (input_is_raw_key_down(key_code_7())) { digit = 7; }
    else if (input_is_raw_key_down(key_code_8())) { digit = 8; }
    else if (input_is_raw_key_down(key_code_9())) { digit = 9; }

    return InputState {
        left_down: raw_left,
        right_down: raw_right,
        up_down: raw_up,
        down_down: raw_down,
        jump_down: raw_jump,
        jump_pressed: jump_just_pressed,
        editor_toggle_pressed: raw_e,
        reset_pressed: raw_r,
        fullscreen_toggle_pressed: raw_f11,
        f5_pressed: raw_f5,
        ctrl_down: raw_ctrl,
        z_pressed: raw_z,
        y_pressed: raw_y,
        mute_pressed: raw_m,
        mouse_x: mpt.x,
        mouse_y: mpt.y,
        mouse_lbutton_down: raw_lmb,
        mouse_lbutton_pressed: lmb_just_pressed,
        mouse_rbutton_down: raw_rmb,
        mouse_rbutton_pressed: rmb_just_pressed,
        digit_pressed: digit,
    };
}
