fn entity_create_bullet(id: i32, x: f32, y: f32, vx: f32, vy: f32): Entity {
    return Entity {
        id: id,
        active: true,
        entity_type: entity_type_bullet(),
        pos_x: x,
        pos_y: y,
        width: 8.0 as f32,
        height: 8.0 as f32,
        vel_x: vx,
        vel_y: vy,
        is_grounded: false,
        gravity_scale: 0.0 as f32,
        col_offset_x: 1.0 as f32,
        col_offset_y: 1.0 as f32,
        col_width: 6.0 as f32,
        col_height: 6.0 as f32,
        is_trigger: true,
        anim: animation_state_create(),
        health: 1,
        max_health: 1,
        coins: 0,
        score: 0,
        patrol_min: 0.0 as f32,
        patrol_max: 0.0 as f32,
        direction: 1.0 as f32,
        coyote_timer: 0.0 as f32,
        invincible_timer: 0.0 as f32,
        ai_state: 0,
        ai_timer: 4.0 as f32, // bullet lifetime
        shoot_timer: 0.0 as f32,
        squash_x: 1.0 as f32,
        squash_y: 1.0 as f32,
        start_x: x,
        start_y: y,
        phase: 1,
    };
}

fn entity_create_boss(id: i32, x: f32, y: f32): Entity {
    mut anim = animation_state_create();
    anim.clip_id = anim_clip_boss();
    return Entity {
        id: id,
        active: true,
        entity_type: entity_type_boss(),
        pos_x: x,
        pos_y: y,
        width: 24.0 as f32,
        height: 32.0 as f32,
        vel_x: 50.0 as f32,
        vel_y: 0.0 as f32,
        is_grounded: true,
        gravity_scale: 1.0 as f32,
        col_offset_x: 2.0 as f32,
        col_offset_y: 2.0 as f32,
        col_width: 20.0 as f32,
        col_height: 30.0 as f32,
        is_trigger: false,
        anim: anim,
        health: 8,
        max_health: 8,
        coins: 0,
        score: 1000,
        patrol_min: x - (120.0 as f32),
        patrol_max: x + (120.0 as f32),
        direction: -1.0 as f32,
        coyote_timer: 0.0 as f32,
        invincible_timer: 0.0 as f32,
        ai_state: ai_state_patrol(),
        ai_timer: 0.0 as f32,
        shoot_timer: 2.0 as f32,
        squash_x: 1.0 as f32,
        squash_y: 1.0 as f32,
        start_x: x,
        start_y: y,
        phase: 1,
    };
}

fn entity_create_platform(id: i32, x: f32, y: f32, min_x: f32, max_x: f32, speed: f32): Entity {
    mut anim = animation_state_create();
    anim.clip_id = anim_clip_platform();
    return Entity {
        id: id,
        active: true,
        entity_type: entity_type_platform(),
        pos_x: x,
        pos_y: y,
        width: 32.0 as f32,
        height: 12.0 as f32,
        vel_x: speed,
        vel_y: 0.0 as f32,
        is_grounded: false,
        gravity_scale: 0.0 as f32,
        col_offset_x: 0.0 as f32,
        col_offset_y: 0.0 as f32,
        col_width: 32.0 as f32,
        col_height: 12.0 as f32,
        is_trigger: false,
        anim: anim,
        health: 1,
        max_health: 1,
        coins: 0,
        score: 0,
        patrol_min: min_x,
        patrol_max: max_x,
        direction: 1.0 as f32,
        coyote_timer: 0.0 as f32,
        invincible_timer: 0.0 as f32,
        ai_state: 0,
        ai_timer: 0.0 as f32,
        shoot_timer: 0.0 as f32,
        squash_x: 1.0 as f32,
        squash_y: 1.0 as f32,
        start_x: x,
        start_y: y,
        phase: 1,
    };
}

fn entity_create_crumble(id: i32, x: f32, y: f32): Entity {
    mut anim = animation_state_create();
    anim.clip_id = anim_clip_crumble();
    return Entity {
        id: id,
        active: true,
        entity_type: entity_type_crumble(),
        pos_x: x,
        pos_y: y,
        width: 16.0 as f32,
        height: 16.0 as f32,
        vel_x: 0.0 as f32,
        vel_y: 0.0 as f32,
        is_grounded: false,
        gravity_scale: 0.0 as f32,
        col_offset_x: 0.0 as f32,
        col_offset_y: 0.0 as f32,
        col_width: 16.0 as f32,
        col_height: 16.0 as f32,
        is_trigger: false,
        anim: anim,
        health: 1,
        max_health: 1,
        coins: 0,
        score: 0,
        patrol_min: 0.0 as f32,
        patrol_max: 0.0 as f32,
        direction: 1.0 as f32,
        coyote_timer: 0.0 as f32,
        invincible_timer: 0.0 as f32,
        ai_state: 0, // 0=idle solid, 1=shaking (0.5s), 2=fallen/hidden (3.0s)
        ai_timer: 0.0 as f32,
        shoot_timer: 0.0 as f32,
        squash_x: 1.0 as f32,
        squash_y: 1.0 as f32,
        start_x: x,
        start_y: y,
        phase: 1,
    };
}

fn entity_create_checkpoint(id: i32, x: f32, y: f32): Entity {
    mut anim = animation_state_create();
    anim.clip_id = anim_clip_checkpoint();
    return Entity {
        id: id,
        active: true,
        entity_type: entity_type_checkpoint(),
