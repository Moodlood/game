        pos_y: y,
        width: 16.0 as f32,
        height: 24.0 as f32,
        vel_x: 0.0 as f32,
        vel_y: 0.0 as f32,
        is_grounded: true,
        gravity_scale: 0.0 as f32,
        col_offset_x: 2.0 as f32,
        col_offset_y: 2.0 as f32,
        col_width: 12.0 as f32,
        col_height: 22.0 as f32,
        is_trigger: true,
        anim: anim,
        health: 1,
        max_health: 1,
        coins: 0,
        score: 50,
        patrol_min: 0.0 as f32,
        patrol_max: 0.0 as f32,
        direction: 1.0 as f32,
        coyote_timer: 0.0 as f32,
        invincible_timer: 0.0 as f32,
        ai_state: 0, // 0 = inactive red, 1 = active green
        ai_timer: 0.0 as f32,
        shoot_timer: 0.0 as f32,
        squash_x: 1.0 as f32,
        squash_y: 1.0 as f32,
        start_x: x,
        start_y: y,
        phase: 1,
    };
}

